# Optional: URL of your AI endpoint (e.g. a Cloudflare Worker running Workers AI).
# Leave empty to use the built-in rule-based answers only.
# Expected: POST { message, history } -> { reply }
VITE_CHAT_API_URL=

# Team admin panel (/admin) login. Defaults: admin / bfc@admin123
# NOTE: these are bundled into the site, so this only keeps casual visitors out.
# For real security move the login to a backend (Firebase Auth, Supabase Auth ...).
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=bfc@admin123
