# Optional: URL of your AI endpoint (e.g. a Cloudflare Worker running Workers AI).
# Leave empty to use the built-in rule-based answers only.
# Expected: POST { message, history } -> { reply }
VITE_CHAT_API_URL=

# Shared database + secure admin login (Supabase) - see README "Supabase setup".
# Both values are public by design; Row Level Security (supabase/schema.sql) protects the data.
# Leave empty to run the panel in browser-only demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode only (no Supabase): login for /admin. Defaults: admin / bfc@admin123
# These end up in the public JS bundle, so they are NOT secure.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=bfc@admin123

# Feedback page: Google Apps Script web app URL that adds each feedback to a Google Sheet.
# Setup steps are at the top of google-apps-script/feedback.gs
VITE_FEEDBACK_SHEET_URL=
